{
  "name": "tab-cove-wxt",
  "description": "A tabs manage extension.",
  "author": "OumCc. <369724377@qq.com>",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">= 24.12.0",
    "npm": ">= 11.6.2",
    "pnpm": ">= 10.28.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
